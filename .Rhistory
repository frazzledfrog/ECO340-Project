names_to = c(".value", "age_group"),
# *** Explicitly name the column for the numeric values ***
values_to = "value",
values_drop_na = TRUE # Drop rows where the pivoted value is NA
)
# --- Debugging Step: Check names right after pivot_longer ---
message("Columns after pivot_longer:")
print(names(gini_timeseries_long_for_plot))
# --- End Debugging Step ---
# Check if '.value' column exists before filtering
if (!".value" %in% names(gini_timeseries_long_for_plot)) {
stop("Error: '.value' column was not created by pivot_longer. Check tidyr version (>= 1.2.0) and names_pattern matching.")
}
# Continue processing pipeline
gini_timeseries_long_for_plot <- gini_timeseries_long_for_plot %>%
# Now filter for the specific measure we want to plot (gini_value)
filter(.value == "gini_value") %>%
# Rename the 'value' column (which holds the actual numeric Gini coefficients)
# to something more descriptive for the plot aesthetics
rename(gini_coefficient = value) %>%
# Add a Date column for plotting on a proper date axis
# (assuming months_from_start=1 corresponds to Jan 2006)
mutate(
# Calculate year and month based on months_from_start
year = 2006 + floor((months_from_start - 1) / 12),
month = ((months_from_start - 1) %% 12) + 1,
# Create a Date object for the first day of the calculated month/year
plot_date = as.Date(paste(year, month, 1, sep = "-"), format = "%Y-%m-%d")
)
# Check if data exists after pivoting and filtering
if (nrow(gini_timeseries_long_for_plot) == 0) {
warning("No data available for plotting after pivoting and filtering for 'gini_value'. Check the dcast output and names_pattern in pivot_longer.")
} else {
message("Plotting Gini coefficients...")
# Create the plot using ggplot2, mapping plot_date to x-axis
gini_plot <- ggplot(gini_timeseries_long_for_plot,
aes(x = plot_date, y = gini_coefficient, color = age_group)) +
geom_line(linewidth = 1) + # Thicker line for visibility
geom_point(size = 1.5) +    # Add points
# Use scale_x_date for better control over date axis formatting
scale_x_date(
date_breaks = "1 year", # Major breaks every year
date_minor_breaks = "3 months", # Minor breaks every 3 months
date_labels = "%Y" # Display only the year for major breaks
) +
scale_y_continuous(limits = c(0, NA), name = "Gini Coefficient") + # Ensure y-axis starts at 0 & label
labs(
title = "Gini Coefficient of Hourly Earnings Over Time by Age Group",
subtitle = "Data processed with data.table, plotted with ggplot2",
x = "Date", # Updated x-axis label
color = "Age Group" # Legend title
) +
theme_minimal(base_size = 12) + # Use a clean theme
theme(
legend.position = "bottom",
axis.text.x = element_text(angle = 45, hjust = 1), # Rotate x-axis labels
plot.title = element_text(hjust = 0.5), # Center title
plot.subtitle = element_text(hjust = 0.5) # Center subtitle
)
# Print the plot to display it
print(gini_plot)
} # End of plot generation block
}, error = function(e) { # Catch errors during plot prep/plotting
message("Error during plotting data preparation or plotting:")
message(e)
# Optionally print traceback
# print(rlang::last_trace())
}) # End of tryCatch block
} else {
message("Skipping plot: 'gini_timeseries' data frame not found, is empty, or has only 'months_from_start' column.")
}
# Add a final success message
message("Script execution finished.")
# --- Setup ---
# Clear workspace
rm(list = ls())
# Set options for knitr (if using R Markdown)
knitr::opts_chunk$set(echo = TRUE)
# --- Package Management ---
# List of required packages
required_packages <- c(
"data.table", # Essential for fread and rbindlist
"dplyr",
"tidyverse",
"plm",
"caret",
"cluster",
"modelsummary",
"ineq"
)
# Check, install (if necessary), and load packages
message("--- Loading Packages ---")
packages_loaded <- sapply(required_packages, function(pkg) {
if (!requireNamespace(pkg, quietly = TRUE)) {
message(paste("Installing package:", pkg))
tryCatch({
install.packages(pkg, dependencies = TRUE)
library(pkg, character.only = TRUE)
message(paste("Successfully installed and loaded:", pkg))
return(TRUE)
}, error = function(e) {
message(paste("Failed to install package:", pkg, "Error:", e$message))
return(FALSE)
})
} else {
library(pkg, character.only = TRUE)
message(paste("Loaded package:", pkg))
return(TRUE)
}
})
# Stop if data.table failed to load, as it's critical
if (!packages_loaded["data.table"]) {
stop("Critical package 'data.table' could not be loaded. Aborting.")
}
message("--- Package Loading Complete ---")
# --- Configuration ---
# Set your working directory to the folder containing the CSV files
# IMPORTANT: Replace "/Users/alex/Desktop/ECO340-Project" with your actual path
csv_folder_path <- "/Users/alex/Desktop/ECO340-Project"
tryCatch({
setwd(csv_folder_path)
message(paste("Working directory set to:", getwd()))
}, warning = function(w){
message(paste("Warning setting working directory:", w$message))
stop("Could not set working directory. Please check the path: ", csv_folder_path)
}, error = function(e) {
message(paste("Error setting working directory:", e$message))
stop("Could not set working directory. Please check the path: ", csv_folder_path)
}
)
# --- Data Loading and Combining ---
message("--- Starting Data Loading ---")
# List all CSV files in the folder
# Using full.names = TRUE provides the full path, which is robust
csv_files <- list.files(pattern = "\\.csv$", full.names = TRUE, ignore.case = TRUE)
# Check if any CSV files were found
if (length(csv_files) == 0) {
stop("No CSV files found in the specified directory: ", csv_folder_path)
} else {
message(paste("Found", length(csv_files), "CSV files. Attempting to read and combine incrementally..."))
# Initialize an empty list to hold data tables temporarily during the loop
# Or initialize the main data table with the first file's content
LFS_data <- NULL
# Loop through each file, read it, and bind it
for (i in seq_along(csv_files)) {
file_path <- csv_files[i]
message(paste("Processing file", i, "of", length(csv_files), ":", basename(file_path)))
current_data <- tryCatch({
# Read the current CSV using fread
data.table::fread(file_path, showProgress = FALSE) # Set showProgress=FALSE for cleaner logs in loop
}, error = function(e) {
# Print error message if reading fails for a specific file
message(paste("Error reading file:", basename(file_path), "-", e$message))
return(NULL) # Return NULL to indicate failure for this file
})
# If reading was successful and data is not empty
if (!is.null(current_data) && nrow(current_data) > 0) {
if (is.null(LFS_data)) {
# If this is the first successfully read file, assign it
LFS_data <- current_data
message("Initialized combined data table.")
} else {
# Otherwise, bind the new data to the existing combined data
# rbindlist is efficient for data.tables
LFS_data <- data.table::rbindlist(list(LFS_data, current_data), use.names = TRUE, fill = TRUE)
# use.names=TRUE and fill=TRUE handle potentially different column orders or missing columns
}
# Optional: Remove the temporary table for the current file immediately
# rm(current_data)
# Optional: Suggest garbage collection periodically (e.g., every 10 files) or less frequently
# if (i %% 10 == 0) { gc() }
} else if (!is.null(current_data) && nrow(current_data) == 0) {
message(paste("Skipping empty file:", basename(file_path)))
# rm(current_data) # remove the empty table
}
# No need for explicit rm(current_data) if not assigned or if loop overwrites it next iteration
} # End of loop
# Final garbage collection suggestion after the loop completes
gc()
message("--- Data Loading Loop Finished ---")
# Check if data loading resulted in a valid data table
if (!is.null(LFS_data) && data.table::is.data.table(LFS_data) && nrow(LFS_data) > 0) {
message("Data loaded and combined successfully.")
message("Dimensions of combined data:")
print(dim(LFS_data))
message("Memory usage of combined data:")
print(object.size(LFS_data), units = "auto")
# message("First few rows of combined data:")
# print(head(LFS_data)) # Uncomment to view the first few rows
} else if (is.null(LFS_data)) {
message("Data loading failed. No data could be read or combined.")
message("Please check file paths, permissions, file integrity, and error messages above.")
} else {
message("Combined data seems empty or is not a data.table. Check source files.")
print(str(LFS_data)) # Print structure for debugging
}
}
# --- End of Script ---
message("--- Script Finished ---")
#For simplicity we will break down the variable LFSSTAT into an Employed binary variable and an in labour force variable. Let's label these is_employed and in_lf -- using these we can more easily down the line calculated changing unemployment rates and labour force participation rates.
#Gender in the LFS datafile is expressed as either a 1 for men and 2 for women, stored as GENDER. We will create a new variable, woman, which will be a binary variable -- 0 for men, 1 for women.
#as opposed to using province codes, I have created new binary variables for the 9 provinces which aren't Ontario. Because I am biased, I will be using Ontario as the default.
#similar to the step for dis-aggregation of the LFSSTAT variable, will decompose the union variable, which gives a 1 for being a union member, a 2 for being covered by union contract, and a 3 for being not covered (an 8 for not being applicable, but dwai bc we won't run a regression on them), into a binary for being a union member (ie 1 only) and a binary for being covered by union contract (1 and 2). we will call these union_member and union_contract (outstanding creativity there w the names)
#same process now for IMMIG, immigration status. going to create variables newer_immigrant for immigrants here for 10 or less years, older_immigrant for those who have been here for more than 10 years.
#education will be broken into culmulative dummies, NOTE TO SELF NEED TO REMEMBER THERE IS SIG COLLINEARITY MUST ACCOUNT FOR, as well as a set of exclusive categories for regression purposes :)
# Assuming LFS_data is your data frame
# Convert LFS_data to a data.table object *in place*
# This is crucial for memory efficiency.
setDT(LFS_data)
# --- Create binary indicator variables using := ---
# The `:=` operator modifies the data.table in place, avoiding copies.
# Employment and Labour Force Status
LFS_data[, is_employed := fifelse(LFSSTAT == 1, 1, 0)]
LFS_data[, in_lf := fifelse(LFSSTAT %in% c(1, 2), 1, 0)]
# Sex
LFS_data[, woman := fifelse(SEX == 2, 1, 0)]
# Province Indicators (using fifelse for speed)
# Note: You could combine these into fewer lines if preferred,
# but separating them is clear.
LFS_data[, prov_nl := fifelse(PROV == 10, 1, 0)]
LFS_data[, prov_pe := fifelse(PROV == 11, 1, 0)]
LFS_data[, prov_ns := fifelse(PROV == 12, 1, 0)]
LFS_data[, prov_nb := fifelse(PROV == 13, 1, 0)]
LFS_data[, prov_qc := fifelse(PROV == 24, 1, 0)]
LFS_data[, prov_mb := fifelse(PROV == 46, 1, 0)]
LFS_data[, prov_sk := fifelse(PROV == 47, 1, 0)]
LFS_data[, prov_ab := fifelse(PROV == 48, 1, 0)]
LFS_data[, prov_bc := fifelse(PROV == 59, 1, 0)]
# Union Status
LFS_data[, union_member := fifelse(UNION == 1, 1, 0)]
LFS_data[, union_contract := fifelse(UNION %in% c(1, 2), 1, 0)]
# Immigration Status
LFS_data[, newer_immigrant := fifelse(IMMIG == 1, 1, 0)]
LFS_data[, older_immigrant := fifelse(IMMIG == 2, 1, 0)]
# Cumulative Education Indicators
LFS_data[, some_hs_plus := fifelse(EDUC >= 1, 1, 0)]
LFS_data[, hs_grad_plus := fifelse(EDUC >= 2, 1, 0)]
LFS_data[, some_ps_plus := fifelse(EDUC >= 3, 1, 0)]
LFS_data[, ps_cert_plus := fifelse(EDUC >= 4, 1, 0)]
LFS_data[, ba_plus := fifelse(EDUC >= 5, 1, 0)]
LFS_data[, above_ba_plus := fifelse(EDUC == 6, 1, 0)]
# Exclusive Education Indicators
LFS_data[, some_hs := fifelse(EDUC == 1, 1, 0)]
LFS_data[, hs_grad := fifelse(EDUC == 2, 1, 0)]
LFS_data[, some_ps := fifelse(EDUC == 3, 1, 0)]
LFS_data[, ps_cert := fifelse(EDUC == 4, 1, 0)]
LFS_data[, ba := fifelse(EDUC == 5, 1, 0)]
LFS_data[, above_ba := fifelse(EDUC == 6, 1, 0)]
# --- Create months_from_start ---
# Assuming the start month is January 2006 (index 1)
# The calculation remains the same, just using the := operator.
LFS_data[, months_from_start := (SURVYEAR - 2006) * 12 + SURVMNTH]
gc()
# Load necessary libraries first (assuming this is done earlier in your script)
# Ensure data.table, dplyr, tidyr, ggplot2, ineq are loaded
# library(data.table)
# library(dplyr)
# library(tidyr)
# library(ggplot2)
# library(ineq)
# --- Ensure LFS_data is a data.table ---
# Assuming LFS_data is loaded and is a data.frame or data.table
# Convert to data.table *before* modifications if it's not already one
if (!is.data.table(LFS_data)) {
setDT(LFS_data)
message("Converted LFS_data to data.table")
} else {
message("LFS_data is already a data.table")
}
# --- Data Manipulation using data.table := ---
# Using := modifies the data.table by reference, which is memory efficient
# and avoids the shallow copy warning.
message("Starting data mutations using data.table syntax...")
# Binary flags for LFSSTAT, SEX, PROV, UNION, IMMIG
LFS_data[, `:=`(
is_employed = fifelse(LFSSTAT == 1, 1, 0), # Use fifelse for speed
in_lf = fifelse(LFSSTAT %in% c(1, 2), 1, 0),
woman = fifelse(SEX == 2, 1, 0),
prov_nl = fifelse(PROV == 10, 1, 0),
prov_pe = fifelse(PROV == 11, 1, 0),
prov_ns = fifelse(PROV == 12, 1, 0),
prov_nb = fifelse(PROV == 13, 1, 0),
prov_qc = fifelse(PROV == 24, 1, 0),
prov_mb = fifelse(PROV == 46, 1, 0),
prov_sk = fifelse(PROV == 47, 1, 0),
prov_ab = fifelse(PROV == 48, 1, 0),
prov_bc = fifelse(PROV == 59, 1, 0),
union_member = fifelse(UNION == 1, 1, 0),
union_contract = fifelse(UNION %in% c(1, 2), 1, 0),
newer_immigrant = fifelse(IMMIG == 1, 1, 0),
older_immigrant = fifelse(IMMIG == 2, 1, 0)
)]
# Education variables (Cumulative and Exclusive)
LFS_data[, `:=`(
# Cumulative Ed
some_hs_plus = fifelse(EDUC >= 1, 1, 0),
hs_grad_plus = fifelse(EDUC >= 2, 1, 0),
some_ps_plus = fifelse(EDUC >= 3, 1, 0),
ps_cert_plus = fifelse(EDUC >= 4, 1, 0),
ba_plus = fifelse(EDUC >= 5, 1, 0),
above_ba_plus = fifelse(EDUC == 6, 1, 0),
# Exclusive Ed
some_hs = fifelse(EDUC == 1, 1, 0),
hs_grad = fifelse(EDUC == 2, 1, 0),
some_ps = fifelse(EDUC == 3, 1, 0),
ps_cert = fifelse(EDUC == 4, 1, 0),
ba = fifelse(EDUC == 5, 1, 0),
above_ba = fifelse(EDUC == 6, 1, 0)
)]
# Rough Age Estimate using fcase (faster than nested ifelse or case_when)
LFS_data[, age_rough := fcase(
AGE_6 == 1, 15.5,      # 15–16 (from AGE_6)
AGE_6 == 2, 18.0,      # 17–19 (from AGE_6) - Use 18.0 to ensure numeric type
AGE_12 == 2, 22.0,     # 20–24
AGE_12 == 3, 27.0,     # 25–29
AGE_12 == 4, 32.0,     # 30–34
AGE_12 == 5, 37.0,     # 35–39
AGE_12 == 6, 42.0,     # 40–44
AGE_12 == 7, 47.0,     # 45–49
AGE_12 == 8, 52.0,     # 50–54
AGE_12 == 9, 57.0,     # 55–59
AGE_12 == 10, 62.0,    # 60–64
AGE_12 == 11, 67.0,    # 65–69
AGE_12 == 12, 75.0,    # 70+
default = NA_real_    # Ensure NA is numeric type
)]
# Months from start
# Ensure SURVYEAR and SURVMNTH are numeric before calculation
if(!is.numeric(LFS_data$SURVYEAR)) LFS_data[, SURVYEAR := as.numeric(SURVYEAR)]
if(!is.numeric(LFS_data$SURVMNTH)) LFS_data[, SURVMNTH := as.numeric(SURVMNTH)]
LFS_data[, months_from_start := (SURVYEAR - 2006) * 12 + SURVMNTH]
message("Finished data mutations.")
# --- Setup ---
